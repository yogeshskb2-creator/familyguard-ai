# ─────────────────────────────────────────────────────────────
# FamilyGuard AI — environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.
# ─────────────────────────────────────────────────────────────

# Firebase Web App config (Firebase console → Project settings → Your apps).
# These are public identifiers, not secrets; access is enforced by
# Firestore Security Rules and server-side checks.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Web push certificate key pair (Cloud Messaging → Web configuration)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Google Maps JavaScript API key — public by design; RESTRICT it by HTTP
# referrer and to the Maps JavaScript API in Google Cloud. Optional: without a key
# the map uses OpenStreetMap street tiles (no key or billing needed).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional vector Map ID (for Advanced Markers + dark styling). Defaults to DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# ── SERVER-ONLY SECRETS (no NEXT_PUBLIC_ prefix — never sent to browser) ──

# Firebase Admin SDK service account. EITHER paste the whole downloaded key
# file (Project settings → Service accounts → Generate new private key) as
# one value:
FIREBASE_SERVICE_ACCOUNT=
# OR set these three (private key with \n escapes):
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# AI providers — SERVER-ONLY (any subset). Unconfigured providers are shown
# as "Not configured"; "Quick answers" works with none.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional model overrides (defaults: claude-opus-5-5, gpt-5.5, gemini-3.8-flash)
CLAUDE_MODEL=
OPENAI_MODEL=
GEMINI_MODEL=

# Security log pseudonymisation salt — SERVER-ONLY. Set a long random value
# (e.g. `openssl rand -hex 32`). User ids in the security log are stored as
# salted hashes; without a custom salt a built-in default is used.
SECURITY_LOG_SALT=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local development only: talk to the Firebase Emulator Suite
# (auth :9099, firestore :8080) instead of the real project.
# When true, also set FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 and
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 for the server-side Admin SDK.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
